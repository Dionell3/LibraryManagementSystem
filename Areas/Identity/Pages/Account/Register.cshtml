@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="lms-page lms-form-page">
    <div class="lms-page-header">
        <div>
            <h1>Create Account</h1>
            <p class="lms-subtitle">Register as a library member to borrow and reserve books.</p>
        </div>
    </div>

    <div class="lms-card" style="max-width:540px;">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="lms-validation-summary"></div>

            <div class="lms-grid-2">
                <div class="lms-field">
                    <label asp-for="Input.FirstName"></label>
                    <input asp-for="Input.FirstName" class="lms-input" placeholder="First name" />
                    <span asp-validation-for="Input.FirstName" class="lms-error"></span>
                </div>
                <div class="lms-field">
                    <label asp-for="Input.LastName"></label>
                    <input asp-for="Input.LastName" class="lms-input" placeholder="Last name" />
                    <span asp-validation-for="Input.LastName" class="lms-error"></span>
                </div>
            </div>

            <div class="lms-field">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="lms-input" autocomplete="username" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="lms-error"></span>
            </div>

            <div class="lms-field">
                <label asp-for="Input.Phone"></label>
                <input asp-for="Input.Phone" class="lms-input" placeholder="Optional" />
                <span asp-validation-for="Input.Phone" class="lms-error"></span>
            </div>

            <div class="lms-field">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="lms-input" autocomplete="new-password" placeholder="Min. 6 characters" type="password" />
                <span asp-validation-for="Input.Password" class="lms-error"></span>
            </div>

            <div class="lms-field">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" class="lms-input" autocomplete="new-password" placeholder="Re-enter password" type="password" />
                <span asp-validation-for="Input.ConfirmPassword" class="lms-error"></span>
            </div>

            <div class="lms-form-actions">
                <button type="submit" class="btn-main">Register</button>
                <a asp-page="./Login" class="lms-btn lms-btn-secondary">Already have an account?</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

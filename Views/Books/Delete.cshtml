@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<h1>Delete Book</h1>
<h4 class="text-danger">Are you sure you want to delete this book?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Author</dt>
    <dd class="col-sm-9">@Model.Author</dd>

    <dt class="col-sm-3">Genre</dt>
    <dd class="col-sm-9">@Model.Genre</dd>

    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@Model.ISBN</dd>

    <dt class="col-sm-3">Available</dt>
    <dd class="col-sm-9">@(Model.IsAvailable ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Summary</dt>
    <dd class="col-sm-9">@Model.Summary</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="BookID" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

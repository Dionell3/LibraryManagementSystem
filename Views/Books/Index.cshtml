@model IEnumerable<LibraryManagementSystem.Models.Book>
@{
    ViewData["Title"] = "Books";
}

<div class="lms-page">
    <div class="lms-page-header">
        <div>
            <h1>Book Catalogue</h1>
            <p class="lms-subtitle">Browse and manage the library's book collection.</p>
        </div>
        @if (User.IsInRole("Librarian") || User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn-main">+ Add New Book</a>
        }
    </div>

    <div class="lms-card lms-filter-bar">
        <form asp-action="Index" method="get">
            <div class="lms-filter-form">
                <div class="lms-filter-field">
                    <label>Search</label>
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="lms-input" placeholder="Search by title, author or genre..." />
                </div>
                <div class="lms-filter-actions" style="align-self:end;">
                    <button type="submit" class="btn-main">Search</button>
                    <a asp-action="Index" class="lms-btn lms-btn-secondary">Clear</a>
                </div>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="lms-empty">
            <h3>No Books Found</h3>
            <p>No books match your search.</p>
        </div>
    }
    else
    {
        <div class="lms-book-grid">
            @foreach (var book in Model)
            {
                <div class="lms-book-card">
                    <div class="lms-book-cover">
                        @if (!string.IsNullOrEmpty(book.CoverImagePath))
                        {
                            <img src="@book.CoverImagePath" alt="@book.Title cover" />
                        }
                        else
                        {
                            <span class="lms-book-placeholder">No Cover</span>
                        }
                    </div>
                    <div class="lms-book-info">
                        <h3>@book.Title</h3>
                        <p class="lms-book-author">by @book.Author</p>
                        <div class="lms-book-meta">
                            <span class="lms-badge lms-badge-genre">@book.Genre</span>
                            @if (book.IsAvailable)
                            {
                                <span class="lms-badge lms-badge-success">Available</span>
                            }
                            else
                            {
                                <span class="lms-badge lms-badge-warning">Unavailable</span>
                            }
                        </div>
                        <div class="lms-book-actions">
                            <a asp-action="Details" asp-route-id="@book.BookID" class="lms-btn lms-btn-info">Details</a>
                            @if (User.IsInRole("Member") && book.IsAvailable)
                            {
                                <form asp-controller="Borrow" asp-action="BorrowBook" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@book.BookID" />
                                    <button type="submit" class="lms-btn lms-btn-warning">Borrow</button>
                                </form>
                            }
                            @if (User.IsInRole("Member") && !book.IsAvailable)
                            {
                                <form asp-controller="Reservation" asp-action="Reserve" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@book.BookID" />
                                    <button type="submit" class="lms-btn lms-btn-secondary">Reserve</button>
                                </form>
                            }
                            @if (User.IsInRole("Librarian") || User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@book.BookID" class="lms-btn lms-btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@book.BookID" class="lms-btn lms-btn-danger">Delete</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

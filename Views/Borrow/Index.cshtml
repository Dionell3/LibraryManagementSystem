@model IEnumerable<LibraryManagementSystem.Models.BorrowTransaction>

<h2>Borrow Transactions</h2>

<a class="btn btn-primary" asp-action="BorrowBook" asp-route-bookId="1">
    Borrow Test Book
</a>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>ID</th>
            <th>Book ID</th>
            <th>Member ID</th>
            <th>Borrow Date</th>
            <th>Due Date</th>
            <th>Return Date</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.BorrowTransactionId</td>
                <td>@item.BookId</td>
                <td>@item.MemberId</td>
                <td>@item.BorrowDate.ToShortDateString()</td>
                <td>@item.DueDate.ToShortDateString()</td>
                <td>@item.ReturnDate?.ToShortDateString()</td>
                <td>@item.Status</td>
                <td>
                    @if (item.Status == "Borrowed")
                    {
                        <a class="btn btn-success"
                               asp-action="ReturnBook"
                               asp-route-id="@item.BorrowTransactionId">
                            Return
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
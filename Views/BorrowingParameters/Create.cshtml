@model LibraryManagementSystem.Models.BorrowingParameters
@{
    ViewData["Title"] = "Add Borrowing Parameters";
}

<div class="lms-page lms-form-page">
    <div class="lms-page-header">
        <div>
            <h1>Add Borrowing Parameters</h1>
            <p class="lms-subtitle">Define loan rules for the library.</p>
        </div>
        <a asp-action="Index" class="lms-btn lms-btn-secondary">Back</a>
    </div>

    <div class="lms-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="lms-validation-summary"></div>

            <div class="lms-field">
                <label asp-for="Label"></label>
                <input asp-for="Label" class="lms-input" placeholder="e.g. Default, Summer Rules" />
                <span asp-validation-for="Label" class="lms-error"></span>
            </div>

            <div class="lms-grid-2">
                <div class="lms-field">
                    <label asp-for="LoanDurationDays"></label>
                    <input asp-for="LoanDurationDays" class="lms-input" type="number" min="1" max="365" />
                    <span class="lms-hint">How many days members can keep a book.</span>
                    <span asp-validation-for="LoanDurationDays" class="lms-error"></span>
                </div>
                <div class="lms-field">
                    <label asp-for="RenewalLimit"></label>
                    <input asp-for="RenewalLimit" class="lms-input" type="number" min="0" max="10" />
                    <span class="lms-hint">Max number of times a loan can be renewed.</span>
                    <span asp-validation-for="RenewalLimit" class="lms-error"></span>
                </div>
            </div>

            <div class="lms-grid-2">
                <div class="lms-field">
                    <label asp-for="OverduePenaltyPerDay"></label>
                    <input asp-for="OverduePenaltyPerDay" class="lms-input" type="number" step="0.01" min="0" max="100" />
                    <span class="lms-hint">Fine charged per day after the due date.</span>
                    <span asp-validation-for="OverduePenaltyPerDay" class="lms-error"></span>
                </div>
                <div class="lms-field">
                    <label asp-for="MaxBorrowableItems"></label>
                    <input asp-for="MaxBorrowableItems" class="lms-input" type="number" min="1" max="20" />
                    <span class="lms-hint">Max books a member can borrow at once.</span>
                    <span asp-validation-for="MaxBorrowableItems" class="lms-error"></span>
                </div>
            </div>

            <div class="lms-form-actions">
                <button type="submit" class="btn-main">Save Parameters</button>
                <a asp-action="Index" class="lms-btn lms-btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

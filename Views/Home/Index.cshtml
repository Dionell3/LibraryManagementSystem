<div class="card-container">
    <div class="info-card">
        <h3>Browse Books</h3>
        <p>Members can view book details such as title, author, genre and availability.</p>
    </div>

    <div class="info-card">
        <h3>Borrow and Reserve</h3>
        <p>Members can borrow, reserve, renew and track their borrowing status.</p>
    </div>

    <div class="info-card">
        <h3>Feedback and Ratings</h3>
        <p>Members can leave feedback and rate books they have read.</p>
    </div>
</div>
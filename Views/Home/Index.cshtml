@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">
    <h1>Library Management System</h1>
    <p>
        A dynamic MVC web application designed to help librarians manage books,
        members, borrowing records, reservations, and library activity.
    </p>

    <a asp-controller="Home" asp-action="MemberDashboard" class="btn-main">Go to Member Dashboard</a>
</div>


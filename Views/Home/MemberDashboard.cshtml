@{
    ViewData["Title"] = "Member Dashboard";
}

<div class="dashboard-header">
    <h1>Member Dashboard</h1>
    <p>Welcome, @ViewBag.MemberName. Here is a summary of your library activity.</p>
</div>

<div class="dashboard-cards">
    <div class="dashboard-card">
        <h2>@ViewBag.AvailableBooks</h2>
        <p>Available Books</p>
    </div>

    <div class="dashboard-card">
        <h2>@ViewBag.BorrowedBooks</h2>
        <p>Borrowed Books</p>
    </div>

    <div class="dashboard-card">
        <h2>@ViewBag.ReservedBooks</h2>
        <p>Reserved Books</p>
    </div>

    <div class="dashboard-card warning">
        <h2>@ViewBag.OverdueBooks</h2>
        <p>Overdue Books</p>
    </div>
</div>

<div class="section">
    <h2>Quick Actions</h2>

    <div class="quick-links">
        <a href="#">Browse Available Books</a>
        <a href="#">View Borrowing History</a>
        <a href="#">Reserve a Book</a>
        <a href="#">Leave Book Feedback</a>
    </div>
</div>

<div class="section">
    <h2>Recommended Books</h2>

    <table class="group-table">
        <tr>
            <th>Book Title</th>
            <th>Author</th>
            <th>Status</th>
        </tr>
        <tr>
            <td>Introduction to Programming</td>
            <td>John Smith</td>
            <td>Available</td>
        </tr>
        <tr>
            <td>Database Systems</td>
            <td>Mary Brown</td>
            <td>Available</td>
        </tr>
        <tr>
            <td>Web Development with MVC</td>
            <td>Ali James</td>
            <td>Borrowed</td>
        </tr>
    </table>
</div>
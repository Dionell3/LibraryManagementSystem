@model LibraryManagementSystem.Models.Librarian
@{
    ViewData["Title"] = "Add New Librarian";
}

<div class="lms-page lms-form-page">
    <div class="lms-page-header">
        <div>
            <h1>Add New Librarian</h1>
            <p class="lms-subtitle">Register a staff member. Employee ID is generated automatically.</p>
        </div>
        <a asp-action="Index" class="lms-btn lms-btn-secondary">Back to Librarians</a>
    </div>

    <div class="lms-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="lms-validation-summary"></div>

            <div class="lms-field">
                <label asp-for="EmployeeID"></label>
                <input asp-for="EmployeeID" class="lms-input" readonly style="background-color:#F5ECE8;cursor:not-allowed;" />
                <span class="lms-hint">Auto-generated. Final ID is assigned when you save.</span>
            </div>

            <div class="lms-grid-2">
                <div class="lms-field">
                    <label asp-for="FirstName"></label>
                    <input asp-for="FirstName" class="lms-input" />
                    <span asp-validation-for="FirstName" class="lms-error"></span>
                </div>
                <div class="lms-field">
                    <label asp-for="LastName"></label>
                    <input asp-for="LastName" class="lms-input" />
                    <span asp-validation-for="LastName" class="lms-error"></span>
                </div>
            </div>

            <div class="lms-grid-2">
                <div class="lms-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="lms-input" type="email" />
                    <span asp-validation-for="Email" class="lms-error"></span>
                </div>
                <div class="lms-field">
                    <label asp-for="Phone"></label>
                    <input asp-for="Phone" class="lms-input" />
                    <span asp-validation-for="Phone" class="lms-error"></span>
                </div>
            </div>

            <div class="lms-grid-2">
                <div class="lms-field">
                    <label asp-for="Position"></label>
                    <select asp-for="Position" class="lms-input">
                        <option value="">-- Select Position --</option>
                        <option value="Head Librarian">Head Librarian</option>
                        <option value="Senior Librarian">Senior Librarian</option>
                        <option value="Librarian">Librarian</option>
                        <option value="Library Assistant">Library Assistant</option>
                    </select>
                    <span asp-validation-for="Position" class="lms-error"></span>
                </div>
                <div class="lms-field">
                    <label asp-for="HireDate"></label>
                    <input asp-for="HireDate" class="lms-input" type="date" />
                    <span asp-validation-for="HireDate" class="lms-error"></span>
                </div>
            </div>

            <div class="lms-form-actions">
                <button type="submit" class="btn-main">Add Librarian</button>
                <a asp-action="Index" class="lms-btn lms-btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

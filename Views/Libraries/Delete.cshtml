@model LibraryManagementSystem.Models.Library

@{
    ViewData["Title"] = "Delete Library";
}

<h1>Delete Library</h1>
<h4 class="text-danger">Are you sure you want to delete this library?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Location</dt>
    <dd class="col-sm-9">@Model.Location</dd>

    <dt class="col-sm-3">Operating Hours</dt>
    <dd class="col-sm-9">@Model.OperatingHours</dd>

    <dt class="col-sm-3">Contact Details</dt>
    <dd class="col-sm-9">@Model.ContactDetails</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="LibraryID" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

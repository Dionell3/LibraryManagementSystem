<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KOI Library</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/library-module.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/koi-unique.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    KOI Library
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Books" asp-action="Index">Browse Books</a>
                        </li>

                        @if (User.IsInRole("Member"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="MemberDashboard">My Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Borrow" asp-action="Index">My Borrows</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reservation" asp-action="Index">My Reservations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Feedback" asp-action="Index">My Feedback</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Member" asp-action="MyProfile">My Profile</a>
                            </li>
                        }

                        @if (User.IsInRole("Librarian") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Manage</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Librarian" asp-action="Dashboard">Dashboard</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Libraries" asp-action="Index">Libraries</a></li>
                                    <li><a class="dropdown-item" asp-controller="Librarian" asp-action="Index">Librarians</a></li>
                                    <li><a class="dropdown-item" asp-controller="Books" asp-action="Index">Books</a></li>
                                    <li><a class="dropdown-item" asp-controller="Member" asp-action="Index">Members</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Borrow" asp-action="Index">Borrow Transactions</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reservation" asp-action="Index">Reservations</a></li>
                                    <li><a class="dropdown-item" asp-controller="Feedback" asp-action="Index">Feedback</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="BorrowingParameters" asp-action="Index">Borrowing Parameters</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="Index">Reports</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        @if (TempData["Success"] != null)
        {
            <div class="lms-alert lms-alert-success mt-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="lms-alert lms-alert-error mt-3">@TempData["Error"]</div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container py-4 text-center">
            <div>
                Where every page turns a new chapter.
            </div>
            <div>&copy; 2026 KOI Library Management System &mdash; ICT272 Web Design and Development T1 2026</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
